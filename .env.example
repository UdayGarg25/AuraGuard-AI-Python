# ============================
# Server
# ============================
HOST=0.0.0.0
# 8000 matches the Node backend's default AI_SERVICE_BASE_URL
# (http://localhost:8000) — keep these in sync if you change either.
PORT=8000
LOG_LEVEL=info

# ============================
# YOLO — general-purpose model
# ============================
# Standard Ultralytics COCO-pretrained model. Auto-downloaded from
# Ultralytics' own servers on first startup if not already cached in
# ./models. Genuinely supports (real trained COCO classes):
#   - person detection   (class "person")
#   - phone detection    (class "cell phone")
YOLO_MODEL=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# ============================
# YOLO — optional face-detection model (leave blank to disable)
# ============================
# A standard COCO model has NO "face" class. Leave this unset and /detect
# honestly reports faceCount/multipleFaces as
# "MODEL SUPPORT REQUIRED / NOT YET IMPLEMENTED" rather than approximating
# it with person-detection. Point this at a real face-trained YOLO .pt file
# (e.g. a YOLOv8 checkpoint trained on WIDER FACE) to activate real face
# counting — no code or API changes needed, just set this path.
YOLO_FACE_MODEL_PATH=

# ============================
# Request limits
# ============================
MAX_IMAGE_SIZE_MB=10

# ============================
# Informational only — for a FUTURE caller (a LiveKit frame sampler this
# service does not implement yet). This service is stateless and
# per-request; it does not pull frames from LiveKit or run a loop, so this
# value is not enforced here.
# ============================
RECOMMENDED_FRAME_SAMPLE_INTERVAL_MS=2000
