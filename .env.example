# ============================
# Server
# ============================
HOST=0.0.0.0
# 8001, not 8000 — the vision service (app/main.py) already uses 8000 and
# both must run concurrently.
PORT=8001

# ============================
# Gemini 2.5 Flash Lite
# Used ONLY for contextual analysis of speech that already tripped the local
# keyword filter (speech/keyword_filter.py) — never called for every chunk.
# ============================
GEMINI_API_KEY=<PASTE_API_KEY_HERE>
GEMINI_MODEL=gemini-2.5-flash-lite

# ============================
# Speech-to-Text (faster-whisper — runs locally, no API key needed)
# Model sizes (smallest→largest): tiny, base, small, medium, large-v3
# "base" is a good CPU-friendly default for near-real-time chunks.
# ============================
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ============================
# Audio chunking
# This is the window size the AUDIO PRODUCER (frontend/Node relay) should
# use when slicing the live LiveKit audio track before sending chunks here.
# The speech service itself doesn't do the chunking — it just documents and
# validates against the expected value. See speech/README.md.
# ============================
AUDIO_CHUNK_INTERVAL_MS=5000

# ============================
# CORS — browser origins allowed to call this API directly
# Vite auto-bumps ports (5174, 5175...) if 5173 is taken by another local
# project — the default here covers that range.
# ============================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# ============================
# Vision service (app/) — YOLO
# Read by app/core/config.py, same as everything above is read by config.py.
# ============================
YOLO_MODEL=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
# Leave blank — see app/services/vision_service.py for why faceCount stays
# honestly "not implemented" rather than approximated from person detection.
YOLO_FACE_MODEL_PATH=
MAX_IMAGE_SIZE_MB=10.0

# ============================
# Vision service — explicit-content detection (NudeNet, local, no API key)
# Ships its own checkpoint inside the pip package — nothing to download.
# ============================
EXPLICIT_CONTENT_ENABLED=true
# Higher than CONFIDENCE_THRESHOLD above on purpose — a false positive here
# is more consequential than an extra misdetected object.
EXPLICIT_CONTENT_CONFIDENCE_THRESHOLD=0.6

# ============================
# Vision service — camera-covered / visibility heuristic
# NOT a YOLO class — see app/services/camera_visibility_service.py.
# ============================
CAMERA_VISIBILITY_DARK_THRESHOLD=20.0
CAMERA_VISIBILITY_FLAT_STDDEV_THRESHOLD=10.0
CAMERA_VISIBILITY_FLAT_DETAIL_THRESHOLD=15.0
